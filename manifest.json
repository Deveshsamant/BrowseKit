{
  "manifest_version": 3,
  "name": "BrowseKit",
  "short_name": "BrowseKit",
  "version": "0.2.0",
  "description": "Privacy-first browser toolkit: tab collections, watch later, media controls and quick tools. All data stays on your device.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "BrowseKit",
    "default_popup": "src/pages/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png"
    }
  },
  "options_page": "src/pages/dashboard/dashboard.html",
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "favicon",
    "contextMenus",
    "activeTab",
    "scripting",
    "sessions"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Open the BrowseKit popup"
    },
    "save-to-watch-later": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Save the current page to Watch Later"
    },
    "media-speed-up": {
      "suggested_key": {
        "default": "Alt+Shift+Period"
      },
      "description": "Media: faster"
    },
    "media-speed-down": {
      "suggested_key": {
        "default": "Alt+Shift+Comma"
      },
      "description": "Media: slower"
    },
    "media-speed-reset": {
      "description": "Media: reset speed to 1×"
    },
    "media-toggle-play": {
      "description": "Media: play / pause"
    },
    "media-toggle-mute": {
      "description": "Media: mute / unmute"
    },
    "media-seek-forward": {
      "description": "Media: skip forward"
    },
    "media-seek-back": {
      "description": "Media: skip back"
    },
    "save-tab-to-vault": {
      "description": "Save the current tab to the last-used TabVault collection"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; connect-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self'; font-src 'self'"
  }
}
